    {
      "parameters": {
        "jsCode": "const answer = $input.first().json.response ||'';\nconst question = $('Code -- Parse & Validate Question').first().json.question;\n\nconst notFound = answer.startsWith('❌');\nconst partial = answer.startsWith('⚠️');\nconst hasCite = answer.includes('📖 Source:');\nconst wordCount = answer.split(/\\s+/).filter(Boolean).length;\n\nconst debugFlags = [];\n\nif (!hasCite && !notFound) debugFlags.push('missing_citation');\nif (wordCount < 15) debugFlags.push('very_short_answer');\nif (answer.toLowerCase().includes('i don\\'t know') && !notFound)\n  debugFlags.push('hallucinated_fallback');\n\nconst httpStatus = notFound ? 404 : 200; // ternary operator\n\n\nreturn [{\n  json: {\n    question,\n    answer,\n    status: notFound ? 'not_found' : (partial ? 'partial' : 'ok'),\n    has_citation: hasCite,\n    http_status: httpStatus,\n    debug: debugFlags.length > 0 ? debugFlags : undefined,\n    answered_at: new Date().toISOString()\n  }\n}];"
      },
